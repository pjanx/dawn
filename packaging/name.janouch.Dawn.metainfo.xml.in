<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
	<id>@DAWN_NAMESPACE@</id>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>MPL-2.0</project_license>
	<name>@PROJECT_NAME@</name>
	<summary>@PROJECT_DESCRIPTION@</summary>
	<description><p>@PROJECT_DESCRIPTION@</p></description>
	<launchable type="desktop-id">@DAWN_NAMESPACE@.desktop</launchable>
	<provides><binary>dn</binary></provides>
	<categories>
		<category>Graphics</category>
		<category>2DGraphics</category>
		<category>Viewer</category>
	</categories>
	<keywords>
		<keyword>image</keyword>
		<keyword>photo</keyword>
		<keyword>picture</keyword>
		<keyword>viewer</keyword>
		<keyword>browser</keyword>
	</keywords>
	<screenshots>
		<screenshot type="default">
			<caption>Browser and viewer modes</caption>
			<image>@PROJECT_HOMEPAGE_URL@/raw/branch/master/docs/dn.webp</image>
		</screenshot>
	</screenshots>
	<url type="homepage">@PROJECT_HOMEPAGE_URL@</url>
	<url type="bugtracker">@PROJECT_HOMEPAGE_URL@/issues</url>
	<developer id="name.janouch">
		<name>@CPACK_PACKAGE_VENDOR@</name>
	</developer>
	<translation type="gettext">dawn</translation>
	<recommends>
		<control>keyboard</control>
		<control>pointing</control>
	</recommends>
	<content_rating type="oars-1.1"/>
</component>
