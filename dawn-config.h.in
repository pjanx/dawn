#pragma once

#cmakedefine01 DAWN_WITH_WIP

#define DAWN_NAME "@PROJECT_NAME@"
#define DAWN_NAMESPACE "@DAWN_NAMESPACE@"
#define DAWN_VERSION "@PROJECT_VERSION@"

// Relocatable packages find theirs next to the executable.
#define DAWN_LOCALEDIR "@CMAKE_INSTALL_FULL_LOCALEDIR@"

#if defined __GNUC__ || defined __clang__
#define DAWN_FORMAT(format_index, first_arg)                                   \
	__attribute__((format(printf, format_index, first_arg)))
#else
#define DAWN_FORMAT(format_index, first_arg)
#endif

#cmakedefine01 DAWN_WITH_LCMS2_FAST_FLOAT
#cmakedefine01 DAWN_WITH_LCMS2_THREADED
#cmakedefine01 DAWN_WITH_JPEG_QS
#cmakedefine01 DAWN_WITH_LIBRAW
#cmakedefine01 DAWN_WITH_LIBWMF
#cmakedefine01 DAWN_WITH_POPPLER
#cmakedefine01 DAWN_WITH_LIBRSVG
#cmakedefine01 DAWN_WITH_XCURSOR
#cmakedefine01 DAWN_WITH_LIBHEIF
#cmakedefine01 DAWN_WITH_LIBJXL
#cmakedefine01 DAWN_WITH_OPENJPEG
#cmakedefine01 DAWN_WITH_LIBTIFF
#cmakedefine01 DAWN_WITH_JXRLIB
#cmakedefine01 DAWN_WITH_DNRS
#cmakedefine01 DAWN_WITH_IMAGEIO
#cmakedefine01 DAWN_WITH_CGPDF

#cmakedefine01 DN_WITH_WAYLAND
