<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	This file is configured three times, by three different things:

	  1. dn/CMakeLists.txt fills in the content type list, with @ONLY,
	  2. Qt's qt_add_executable finalizer copies the result through a second
	     @ONLY pass (_qt_internal_copy_info_plist), by which point nothing
	     is left for it to substitute,
	  3. CMake substitutes the MACOSX_BUNDLE_ entries from target properties.

	At-sign placeholders are therefore ours and Qt's, dollar-brace ones are
	CMake's.  Naming a bundle key with at-signs would have Qt substitute it in
	Qt's own scope, where it is undefined, and the value would silently come
	out empty.  All three passes rewrite this comment as well, so do not write
	either kind of placeholder here, not even to illustrate the point.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundleIconFile</key>
	<string>${MACOSX_BUNDLE_ICON_FILE}</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>LSMinimumSystemVersion</key>
	<string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
	<key>NSHumanReadableCopyright</key>
	<string>${MACOSX_BUNDLE_COPYRIGHT}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>

	<!-- From Qt's own template.  -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSRequiresAquaSystemAppearance</key>
	<false/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>

	<!-- Locations macOS withholds until the user consents.  The purpose
	     string is what the consent dialog has to show; leaving one out gets
	     the browser refused with no way for the user to say yes.  -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>Dawn can show images kept on your Desktop.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Dawn can show images kept in your Documents folder.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Dawn can show images kept in your Downloads folder.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Dawn can show images kept on removable volumes.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Dawn can show images kept on network volumes.</string>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>@DN_MACOS_CONTENT_TYPES@
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
